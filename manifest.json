{
    "manifest_version": 3,

    "tasks": [
        {
            "id": "disk-reclaim-v1",
            "type": "script",
            "source": "scripts/Invoke-DiskReclaim.ps1",
            "sha256": "REPLACE_WITH_REAL_HASH",
            "arguments": "-Silent",
            "targets": {
                "projects": ["NLTP_Nigeria_MinXray", "NLTP_Nigeria_Fuji"],
                "sites": ["*"]
            },
            "window": "01:00-05:00",
            "run_once": true,
            "timeout_minutes": 90
        },
        {
            "id": "qureapi-tools-1.4.2",
            "type": "package",
            "source": "packages/qureapi-tools/1.4.2/payload.zip",
            "sha256": "REPLACE_WITH_REAL_HASH",
            "install_command": "install.ps1",
            "arguments": "-Silent",
            "targets": {
                "projects": ["*"],
                "sites": ["*"]
            },
            "window": "",
            "run_once": true,
            "timeout_minutes": 60
        }
    ]
}
